{
  "openapi": "3.1.0",
  "info": {
    "title": "Is There a Burn Ban? Read API",
    "version": "1.1.0",
    "description": "Published county burn-ban reports, standing restrictions and selected National Weather Service fire-weather signals. An hourly job schedules due sources. Coverage and cadence vary by publisher. Informational only. Confirm restrictions with the official authority before burning.",
    "termsOfService": "https://site.example/terms/",
    "contact": {
      "name": "Is There a Burn Ban?",
      "url": "https://site.example/developers/",
      "email": "hello@isthereaburnban.com"
    },
    "license": {
      "name": "Attribute and link each source. Verify publisher terms before republishing source records.",
      "url": "https://site.example/terms/"
    }
  },
  "servers": [
    {
      "url": "https://site.example"
    }
  ],
  "paths": {
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Published burn reports by ZIP, coordinates, FIPS or incorporated place",
        "parameters": [
          {
            "name": "zip",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{5}$"
            },
            "example": "74103",
            "description": "Five-digit US ZIP. Census 2020 ZIP areas determine mapped county overlaps. An absent ZIP may have a same-prefix substitute selected by numeric distance."
          },
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 36.154,
            "description": "Latitude. Coordinates sent to the Census geocoder are rounded to three decimals."
          },
          {
            "name": "lon",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": -95.993,
            "description": "Longitude. Coordinates sent to the Census geocoder are rounded to three decimals."
          },
          {
            "name": "fips",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{5}$"
            },
            "example": "48453"
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 80
            },
            "example": "Tulsa",
            "description": "Incorporated city, town or village name, or a disambiguating page slug. Include the state for names shared across states."
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "example": "OK",
            "description": "2-letter state code, used with city"
          },
          {
            "name": "here",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Request an approximate county match using the caller’s IP location."
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "text"
              ]
            },
            "description": "text returns a plain county report for each result or a request to confirm an approximate location."
          }
        ],
        "responses": {
          "200": {
            "description": "County report or location candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResult"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Location or county could not be matched",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "IP location unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Census geocoder unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "County reports can differ across a place. Approximate ZIP and IP lookups provide candidates for confirmation. Coordinate results use 2020 Census county boundaries. Location estimates and coordinate responses are private and no-store."
      }
    },
    "/api/v1/bans": {
      "get": {
        "operationId": "listBans",
        "summary": "Published active burn bans and restrictions",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "example": "TX"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "generated": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "counties": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CountyStatus"
                      }
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SourceHealth"
                      }
                    },
                    "disclaimer": {
                      "type": "string",
                      "examples": [
                        "Informational only. Always confirm with the official source before burning."
                      ]
                    },
                    "unknownCount": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Number of counties with unconfirmed status when a state is requested."
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Published county summaries with a ban or restriction, including scoped orders. The list reflects available evidence."
      }
    },
    "/api/v1/coverage": {
      "get": {
        "operationId": "getCoverage",
        "summary": "Coverage level and official links per state, plus source health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "generated": {
                      "type": "string"
                    },
                    "states": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StateDirectoryEntry"
                      }
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SourceHealth"
                      }
                    },
                    "disclaimer": {
                      "type": "string",
                      "examples": [
                        "Informational only. Always confirm with the official source before burning."
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/counties/{fips}": {
      "get": {
        "operationId": "getCounty",
        "summary": "Published report for one county",
        "parameters": [
          {
            "name": "fips",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{5}$"
            },
            "example": "40143"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/CountyStatus"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "disclaimer": {
                          "type": "string",
                          "examples": [
                            "Informational only. Always confirm with the official source before burning."
                          ]
                        },
                        "generated": {
                          "type": "string",
                          "description": "Publication timestamp for this county answer.",
                          "format": "date-time"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Bad input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fire-weather": {
      "get": {
        "operationId": "listFireWeather",
        "summary": "Published National Weather Service fire-weather signals by county",
        "description": "Selected NWS alerts that mapped to a county. Alerts may cover part of the county or have a future onset. Check the source health and alert boundaries.",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "example": "TX"
          }
        ],
        "responses": {
          "200": {
            "description": "County alerts and national NWS source health",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "generated",
                    "counties",
                    "source",
                    "disclaimer"
                  ],
                  "properties": {
                    "generated": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "counties": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "fips",
                          "state",
                          "county",
                          "alerts"
                        ],
                        "properties": {
                          "fips": {
                            "type": "string",
                            "pattern": "^\\d{5}$"
                          },
                          "state": {
                            "type": "string"
                          },
                          "county": {
                            "type": "string"
                          },
                          "alerts": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/FireWeatherAlert"
                            }
                          }
                        }
                      }
                    },
                    "source": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/SourceHealth"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "disclaimer": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string",
                      "description": "Present when no published signal matches the query."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map-status": {
      "get": {
        "operationId": "getMapStatus",
        "summary": "Compact map of county reports",
        "description": "Known county statuses from the same publication reader as county lookups. Omitted counties and expired responses are unconfirmed.",
        "responses": {
          "200": {
            "description": "Revision-pinned map with expiry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "revision",
                    "expiresAt",
                    "counties"
                  ],
                  "properties": {
                    "revision": {
                      "type": "string",
                      "description": "Pinned publication revision."
                    },
                    "expiresAt": {
                      "type": "integer",
                      "description": "Exclusive UTC epoch-millisecond cutoff for displaying this projection."
                    },
                    "counties": {
                      "type": "object",
                      "propertyNames": {
                        "pattern": "^\\d{5}$"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "ban",
                          "restricted",
                          "none"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BanStatus": {
        "type": "string",
        "enum": [
          "ban",
          "restricted",
          "none",
          "unknown"
        ],
        "description": "ban means a reported burn ban. restricted means a local, activity-specific or permit restriction. none means no applicable temporary county order was reported within the checked feed coverage. unknown means the status is unconfirmed because evidence is missing, unreported, expired or unavailable."
      },
      "CountyStatus": {
        "type": "object",
        "required": [
          "fips",
          "state",
          "county",
          "status",
          "label",
          "since",
          "expires",
          "sourceUpdated",
          "checked",
          "sourceName",
          "sourceUrl",
          "officialUrl"
        ],
        "properties": {
          "fips": {
            "type": "string",
            "pattern": "^\\d{5}$",
            "examples": [
              "40143"
            ]
          },
          "state": {
            "type": "string",
            "examples": [
              "OK"
            ]
          },
          "county": {
            "type": "string",
            "examples": [
              "Tulsa County"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/BanStatus"
          },
          "label": {
            "type": "string",
            "description": "Normalized human-readable report label.",
            "examples": [
              "County Burn Ban"
            ]
          },
          "since": {
            "type": [
              "string",
              "null"
            ],
            "description": "Effective date or ISO timestamp provided by the publisher. Null when unavailable."
          },
          "expires": {
            "type": [
              "string",
              "null"
            ],
            "description": "End date or timestamp supplied by the publisher. A date-only end follows the publisher’s local calendar and inclusive or exclusive convention. See validUntil for the read cutoff when known."
          },
          "sourceUpdated": {
            "type": [
              "string",
              "null"
            ],
            "description": "Publisher report or edit date, in ISO date or timestamp form."
          },
          "checked": {
            "type": [
              "string",
              "null"
            ],
            "description": "Last successful source check for the report. Null for a directory fallback or an unavailable check time.",
            "format": "date-time"
          },
          "sourceName": {
            "type": "string",
            "description": "Publisher or issuing authority associated with this report."
          },
          "sourceUrl": {
            "type": "string",
            "description": "Retrieved publication or machine endpoint. Empty for a directory fallback."
          },
          "officialUrl": {
            "type": "string",
            "description": "Issuing order, agency report or official directory link. Empty if unavailable."
          },
          "note": {
            "type": "string",
            "description": "Scope, applicable activity, exemptions or other context when known."
          },
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FireWeatherAlert"
            },
            "description": "Selected published NWS fire-weather signals. Check onset and alert boundaries. A verified local rule may separately trigger scoped restrictions."
          },
          "orders": {
            "type": "array",
            "description": "Scoped, standing and weather-triggered orders or rules attached to this county report. Check each order’s applicability and timing.",
            "items": {
              "$ref": "#/components/schemas/ScopedOrder"
            }
          },
          "firstSeenAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "First time this service recorded a report for this county under current observation tracking.",
            "format": "date-time"
          },
          "statusChangedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Time this service last observed the published county status change.",
            "format": "date-time"
          },
          "lastAttemptedAt": {
            "type": "string",
            "description": "Latest source attempt if known. It can differ from the last successful check.",
            "format": "date-time"
          },
          "sourceCheckFailed": {
            "type": "boolean",
            "const": true,
            "description": "Present when the latest attempt for this report failed."
          },
          "scope": {
            "type": "string",
            "enum": [
              "county",
              "part",
              "state"
            ],
            "description": "Reported geographic authority or area. Read scopeNote for narrower applicability."
          },
          "scopeNote": {
            "type": "string",
            "description": "Applicable area or activity, as reported or verified."
          },
          "standing": {
            "type": "boolean",
            "const": true,
            "description": "Ongoing, activity-specific rule."
          },
          "sourceId": {
            "type": "string",
            "description": "Stable ID for the source in the coverage response."
          },
          "validFrom": {
            "type": "string",
            "description": "UTC instant when a dated or scheduled decision begins to apply.",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "description": "Exclusive UTC cutoff for the report’s validity or freshness window, when known.",
            "format": "date-time"
          },
          "countywide": {
            "type": "object",
            "description": "Separate broader report when a scoped or activity-specific rule supplies the headline.",
            "properties": {
              "status": {
                "$ref": "#/components/schemas/BanStatus"
              },
              "label": {
                "type": "string",
                "description": "Normalized human-readable report label.",
                "examples": [
                  "County Burn Ban"
                ]
              },
              "checked": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Last successful source check for the report. Null for a directory fallback or an unavailable check time.",
                "format": "date-time"
              },
              "sourceId": {
                "type": "string",
                "description": "Stable ID for the source in the coverage response."
              },
              "sourceName": {
                "type": "string",
                "description": "Publisher or issuing authority associated with this report."
              },
              "sourceUpdated": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Publisher report or edit date, in ISO date or timestamp form."
              },
              "officialUrl": {
                "type": "string",
                "description": "Issuing order, agency report or official directory link. Empty if unavailable."
              }
            }
          }
        }
      },
      "SourceHealth": {
        "type": "object",
        "required": [
          "id",
          "state",
          "ok",
          "checked",
          "counties",
          "bans",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "description": "Two-letter state code, or US for a national source"
          },
          "ok": {
            "type": "boolean",
            "description": "Latest source check succeeded when a check exists."
          },
          "checked": {
            "type": "string",
            "format": "date-time",
            "description": "Compatibility timestamp. Use lastAttemptedAt and lastSuccessfulAt to distinguish attempts from successful checks."
          },
          "error": {
            "type": "string"
          },
          "counties": {
            "type": "integer"
          },
          "bans": {
            "type": "integer"
          },
          "mode": {
            "type": "string",
            "enum": [
              "full",
              "positive-only",
              "manual"
            ],
            "description": "full means the feed supplies explicit county status within its reporting scope, which can be voluntary. positive-only means omissions are unconfirmed. manual is a reference without automated status."
          },
          "product": {
            "type": "string",
            "enum": [
              "fire-weather"
            ],
            "description": "Selected NWS fire-weather signal source."
          },
          "scope": {
            "type": "string",
            "enum": [
              "county",
              "part",
              "state"
            ],
            "description": "Reported geographic authority or area. Read scopeNote for narrower applicability."
          },
          "officialUrl": {
            "type": "string",
            "description": "Issuing order, agency report or official directory link. Empty if unavailable."
          },
          "sourceName": {
            "type": "string",
            "description": "Publisher or issuing authority associated with this report."
          },
          "sourceUrl": {
            "type": "string",
            "description": "Retrieved publication or machine endpoint. Empty for a directory fallback."
          },
          "lastAttemptedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest automated check attempt, if known.",
            "format": "date-time"
          },
          "lastSuccessfulAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest successful automated check, if known.",
            "format": "date-time"
          },
          "cadence": {
            "type": [
              "object",
              "null"
            ],
            "description": "Configured poll cadence from the coverage endpoint. Null for a manual source.",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "hourly",
                  "daily"
                ]
              },
              "zone": {
                "type": "string",
                "description": "IANA time zone for daily polls."
              },
              "hours": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23
                },
                "description": "Scheduled local hours for daily polls."
              }
            }
          }
        }
      },
      "StateDirectoryEntry": {
        "type": "object",
        "properties": {
          "abbr": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "coverage": {
            "type": "string",
            "enum": [
              "live",
              "restrictions",
              "directory"
            ],
            "description": "Configured directory tier. live is a county-reporting feed, restrictions is selected automated reports, directory is manual references."
          },
          "publisher": {
            "type": "string"
          },
          "officialUrl": {
            "type": "string"
          },
          "extraUrls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "LookupResult": {
        "type": "object",
        "properties": {
          "query": {
            "type": "object",
            "properties": {
              "zip": {
                "type": "string"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              },
              "fips": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "here": {
                "type": "boolean",
                "const": true
              }
            }
          },
          "ambiguous": {
            "type": "boolean",
            "description": "The selected place or ZIP area maps to multiple county candidates."
          },
          "approximate": {
            "type": "boolean",
            "description": "Location requires confirmation after a numeric ZIP substitute or an IP estimate. Candidate statuses are unknown until confirmed."
          },
          "results": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/CountyStatus"
                },
                {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "examples": [
                        "/us/ok/tulsa-county/"
                      ]
                    }
                  }
                }
              ]
            },
            "description": "ZIP counties are ordered by Census 2020 land overlap. Incorporated places use county population overlap where available, with a representative-point fallback."
          },
          "disclaimer": {
            "type": "string",
            "examples": [
              "Informational only. Always confirm with the official source before burning."
            ]
          },
          "place": {
            "type": "object",
            "description": "Matched Census incorporated place, its supported county FIPS, and a city or county page. Same-state name matches normally select the most populous place. Use a disambiguating page slug when available.",
            "properties": {
              "name": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "description": "Page path, e.g. /us/ok/city/tulsa/"
              },
              "counties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "localRulesUrl": {
                "type": "string",
                "description": "Known municipal burning guidance or fire authority."
              }
            }
          },
          "answer": {
            "type": "string",
            "enum": [
              "ban",
              "restricted",
              "none",
              "unknown",
              "depends"
            ],
            "description": "Place-level answer. depends means mapped counties disagree. Approximate locations have an unknown answer until the county is confirmed."
          },
          "generated": {
            "type": [
              "string",
              "null"
            ],
            "description": "County publication time. Null when the answer only offers unconfirmed location candidates.",
            "format": "date-time"
          },
          "matchedZip": {
            "type": "string",
            "pattern": "^\\d{5}$",
            "description": "Mapped Census ZIP-area ID for a ZIP lookup. Compare it with the requested ZIP."
          },
          "approximationReason": {
            "type": "string",
            "description": "Reason the ZIP was substituted or the location was estimated."
          }
        },
        "required": [
          "query",
          "answer",
          "generated",
          "ambiguous",
          "approximate",
          "results",
          "disclaimer"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
