      "ScopedOrder": {
        "type": "object",
        "required": [
          "status",
          "label",
          "scope",
          "scopeNote",
          "since",
          "expires",
          "checked",
          "sourceName",
          "sourceUpdated",
          "officialUrl"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/BanStatus"
          },
          "label": {
            "type": "string",
