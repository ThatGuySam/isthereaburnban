              "Red Flag Warning",
              "Fire Weather Watch",
              "Extreme Fire Danger",
              "Fire Danger Statement"
            ]
          },
          "headline": {
            "type": "string"
          },
          "onset": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Expected start of the weather event"
          },
          "expires": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "CAP message expiry"
          },
          "ends": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Expected end of the weather event, when supplied"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Official NWS alert"
          },
          "sender": {
            "type": "string",
