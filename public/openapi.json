{
  "openapi": "3.1.0",
  "info": {
    "title": "Is There a Burn Ban? API",
    "version": "1.1.0",
    "description": "County burn status and National Weather Service fire-weather alerts, refreshed hourly. Informational only. Confirm restrictions with the official authority before burning.",
    "termsOfService": "https://isthereaburnban.com/terms/",
    "contact": {
      "name": "Is There a Burn Ban?",
      "url": "https://isthereaburnban.com/developers/",
      "email": "hello@isthereaburnban.com"
    },
    "license": {
      "name": "Facts summarized from public agencies; attribute and link each source. See terms.",
      "url": "https://isthereaburnban.com/terms/"
    }
  },
  "servers": [
    {
      "url": "https://isthereaburnban.com"
    }
  ],
  "paths": {
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Burn ban status for a ZIP, coordinates, county FIPS, city and state, or the caller's IP location",
        "parameters": [
          {
            "name": "zip",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{5}$"
            },
            "example": "74103"
          },
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 36.154
          },
          {
            "name": "lon",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": -95.993
          },
          {
            "name": "fips",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{5}$"
            },
            "example": "48453"
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 80
            },
            "example": "Tulsa",
            "description": "Incorporated city, town or village name. Pass state too; a name used in several states returns 400. Small towns without a page resolve to their county."
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "example": "OK",
            "description": "2-letter state code, used with city"
          },
          {
            "name": "here",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Use the request's approximate IP location"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "text"
              ]
            },
            "description": "text returns one plain sentence per county"
          }
        ],
        "responses": {
          "200": {
            "description": "One result per county",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResult"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Bad input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bans": {
      "get": {
        "operationId": "listBans",
        "summary": "Counties with an active ban or restriction",
        "description": "Returns the full matching list when limit and cursor are omitted. For a bounded response, set limit or pass a previous page’s next cursor with the same state filter. The cursor is exclusive and reflects live data.",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "example": "TX"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 },
            "description": "Page size. Defaults to 50 when a cursor is supplied without a limit."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string", "maxLength": 9 },
            "description": "Use the previous page’s next cursor with the same state filter."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "generated": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "counties": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CountyStatus"
                      }
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SourceHealth"
                      }
                    },
                    "count": {
                      "type": "integer",
                      "description": "Number of counties on this page. Included when paginated."
                    },
                    "total": {
                      "type": "integer",
                      "description": "Number of current matches across all pages. Included when paginated."
                    },
                    "next": {
                      "type": ["string", "null"],
                      "description": "Cursor for the next page, or null at the end. Included when paginated."
                    },
                    "disclaimer": {
                      "type": "string",
                      "examples": [
                        "Informational only. Always confirm with the official source before burning."
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid limit or cursor" }
        }
      }
    },
    "/api/v1/coverage": {
      "get": {
        "operationId": "getCoverage",
        "summary": "Coverage level and official links per state, plus source health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "generated": {
                      "type": "string"
                    },
                    "states": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StateDirectoryEntry"
                      }
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SourceHealth"
                      }
                    },
                    "disclaimer": {
                      "type": "string",
                      "examples": [
                        "Informational only. Always confirm with the official source before burning."
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/counties/{fips}": {
      "get": {
        "operationId": "getCounty",
        "summary": "Status for one county",
        "parameters": [
          {
            "name": "fips",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{5}$"
            },
            "example": "40143"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/CountyStatus"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "disclaimer": {
                          "type": "string",
                          "examples": [
                            "Informational only. Always confirm with the official source before burning."
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Bad input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fire-weather": {
      "get": {
        "operationId": "listFireWeather",
        "summary": "Current National Weather Service fire-weather alerts by county",
        "description": "Weather signals can apply to part of a county. An issued warning or watch may have a future onset. Omitted counties have no current alert in the last published feed.",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "example": "TX"
          }
        ],
        "responses": {
          "200": {
            "description": "County alerts and national NWS source health",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "generated",
                    "counties",
                    "source",
                    "disclaimer"
                  ],
                  "properties": {
                    "generated": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "counties": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "fips",
                          "state",
                          "county",
                          "alerts"
                        ],
                        "properties": {
                          "fips": {
                            "type": "string",
                            "pattern": "^\\d{5}$"
                          },
                          "state": {
                            "type": "string"
                          },
                          "county": {
                            "type": "string"
                          },
                          "alerts": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/FireWeatherAlert"
                            }
                          }
                        }
                      }
                    },
                    "source": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/SourceHealth"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "disclaimer": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BanStatus": {
        "type": "string",
        "enum": [
          "ban",
          "restricted",
          "none",
          "unknown"
        ],
        "description": "none = the official source covers this county and reports no ban. unknown = no feed, failed, stale, or not reported; never treat as permission to burn."
      },
      "CountyStatus": {
        "type": "object",
        "required": [
          "fips",
          "state",
          "county",
          "status",
          "label",
          "since",
          "expires",
          "sourceUpdated",
          "checked",
          "sourceName",
          "sourceUrl",
          "officialUrl"
        ],
        "properties": {
          "fips": {
            "type": "string",
            "pattern": "^\\d{5}$",
            "examples": [
              "40143"
            ]
          },
          "state": {
            "type": "string",
            "examples": [
              "OK"
            ]
          },
          "county": {
            "type": "string",
            "examples": [
              "Tulsa County"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/BanStatus"
          },
          "label": {
            "type": "string",
            "description": "Human label from the source",
            "examples": [
              "County Burn Ban"
            ]
          },
          "since": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the ban started (source), or when we first saw this status"
          },
          "expires": {
            "type": [
              "string",
              "null"
            ],
            "description": "Expiry date when the source gives one"
          },
          "sourceUpdated": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "checked": {
            "type": "string",
            "format": "date-time",
            "description": "When this county decision was last confirmed or evaluated from a pinned recurring rule"
          },
          "sourceName": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "description": "Machine endpoint we read"
          },
          "officialUrl": {
            "type": "string",
            "format": "uri",
            "description": "Official human page to confirm with"
          },
          "note": {
            "type": "string"
          },
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FireWeatherAlert"
            },
            "description": "Current NWS fire-weather signals that can cover part of the county. A verified local rule can independently trigger a scoped restriction."
          },
          "orders": {
            "type": "array",
            "description": "Scoped orders and legal restrictions. A weather-triggered order links to the rule that authorizes it.",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "$ref": "#/components/schemas/BanStatus"
                },
                "label": {
                  "type": "string"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "part",
                    "county",
                    "state"
                  ]
                },
                "scopeNote": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "officialUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "validFrom": {
                  "type": "string",
                  "format": "date-time"
                },
                "validUntil": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "SourceHealth": {
        "type": "object",
        "required": [
          "id",
          "state",
          "ok",
          "checked",
          "counties",
          "bans",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "description": "Two-letter state code, or US for a national source"
          },
          "ok": {
            "type": "boolean"
          },
          "checked": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string"
          },
          "warning": {
            "type": "string",
            "description": "A pinned recurring rule is still being evaluated while the official page is unreachable, for up to 30 days without verification."
          },
          "counties": {
            "type": "integer"
          },
          "bans": {
            "type": "integer"
          },
          "mode": {
            "type": "string",
            "enum": [
              "full",
              "positive-only",
              "manual"
            ],
            "description": "positive-only: absence of a ban means unknown, not none"
          },
          "product": {
            "type": "string",
            "enum": [
              "fire-weather"
            ],
            "description": "Signal source with nationwide fire-weather coverage"
          }
        }
      },
      "StateDirectoryEntry": {
        "type": "object",
        "properties": {
          "abbr": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "coverage": {
            "type": "string",
            "enum": [
              "live",
              "restrictions",
              "directory"
            ]
          },
          "publisher": {
            "type": "string"
          },
          "officialUrl": {
            "type": "string"
          },
          "extraUrls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "LookupResult": {
        "type": "object",
        "properties": {
          "query": {
            "type": "object",
            "properties": {
              "zip": {
                "type": "string"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              },
              "fips": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              }
            }
          },
          "ambiguous": {
            "type": "boolean",
            "description": "The ZIP or city touches more than one county"
          },
          "approximate": {
            "type": "boolean",
            "description": "The ZIP wasn't in Census data; the nearest ZIP was used"
          },
          "results": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/CountyStatus"
                },
                {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "examples": [
                        "/us/ok/tulsa-county/"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "disclaimer": {
            "type": "string",
            "examples": [
              "Informational only. Always confirm with the official source before burning."
            ]
          },
          "place": {
            "type": "object",
            "description": "Set for city lookups: the matched place, its page (or its county page) and every county it touches, largest population share first",
            "properties": {
              "name": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "description": "Page path, e.g. /us/ok/city/tulsa/"
              },
              "counties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "disclaimer": {
            "type": "string",
            "examples": [
              "Informational only. Always confirm with the official source before burning."
            ]
          }
        }
      },
      "FireWeatherAlert": {
        "type": "object",
        "required": [
          "event",
          "headline",
          "onset",
          "expires",
          "ends",
          "url",
          "sender"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "Red Flag Warning",
              "Fire Weather Watch",
              "Extreme Fire Danger",
              "Fire Danger Statement"
            ]
          },
          "headline": {
            "type": "string"
          },
          "onset": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Expected start of the weather event"
          },
          "expires": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "CAP message expiry"
          },
          "ends": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Expected end of the weather event, when supplied"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Official NWS alert"
          },
          "sender": {
            "type": "string",
            "description": "NWS issuing office"
          }
        }
      }
    }
  },
  "externalDocs": {
    "description": "Dataset description, sources and attribution",
    "url": "https://isthereaburnban.com/data/"
  }
}
