---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Sheets from "../components/Sheets.tsx";
import { SITE } from "../components/site-data";

interface Props {
  title: string;
  description: string;
  /** path like /us/ok/ ; omit for pages that should not be canonicalized */
  path?: string;
  jsonLd?: Record<string, unknown>[];
  /** data-ld key for the WebPage block so the Worker can inject dateModified */
  noindex?: boolean;
  /** mount the React sheets island (location / alert / menu) */
  sheets?: boolean;
  /** site footer at the end of the page; full-screen pages leave it out */
  footer?: boolean;
  themeColor?: string;
  /**
   * Lets the Worker answer in the <title> and description (src/worker/pages.ts): the question,
   * the county FIPS codes the answer depends on, and the city name for city pages.
   */
  answer?: { question: string; fips: string[]; city?: string };
  /** machine-readable version of this page (rel=alternate, application/json) */
  apiHref?: string;
}

const { title, description, path, jsonLd = [], noindex = false, sheets = false, footer = true, themeColor = "#2a9d70", answer, apiHref } = Astro.props;
const canonical = path ? new URL(path, SITE).href : undefined;
const ld = (o: Record<string, unknown>) => JSON.stringify(o).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en" data-q={answer?.question} data-answer-fips={answer?.fips.join(",")} data-city={answer?.city}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL("/icons/icon-512.png", SITE).href} />
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href="/fonts/montserrat-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    {apiHref && <link rel="alternate" type="application/json" href={apiHref} title="Burn ban status as JSON" />}
    {jsonLd.map((o) => <script type="application/ld+json" data-ld={String(o["@type"])} set:html={ld(o)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <slot />
    {footer && <Footer />}
    {sheets && <Sheets client:idle />}
  </body>
</html>
