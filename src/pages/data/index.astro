---
import Base from "../../layouts/Base.astro";
import { DOCS_ORIGIN } from "../../shared/site-origin";
import { CONTACT_EMAIL, SITE, states, statePath } from "../../components/site-data";

const live = states.filter((s) => s.coverage === "live");
const restrictions = states.filter((s) => s.coverage === "restrictions");
const directory = states.filter((s) => s.coverage === "directory");

const NAME = "US county burn ban status";
// Keep this text and the visible "About this dataset" paragraphs saying the same thing (Google checks they match).
const DESCRIPTION =
  `County burn-ban reports and restrictions from the sources we check. Coverage and schedule vary by publisher. ` +
  `Source-backed records include the publisher, its link and our last successful check. Unconfirmed counties can link to an official directory. ` +
  `${live.length} states have county-reporting feeds and ${restrictions.length} areas have selected restriction sources. ` +
  `Selected National Weather Service fire-weather signals are associated with counties. Confirm the issuing authority before burning.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: NAME,
    description: DESCRIPTION,
    url: `${SITE}/data/`,
    sameAs: `${DOCS_ORIGIN}/developers/`,
    keywords: ["burn ban", "fire restrictions", "outdoor burning", "red flag warning", "county", "United States"],
    creator: { "@type": "Organization", name: "Is There a Burn Ban?", url: `${SITE}/`, email: CONTACT_EMAIL },
    license: `${SITE}/terms/`,
    isAccessibleForFree: true,
    temporalCoverage: "2026-11/..",
    spatialCoverage: { "@type": "Place", name: "United States", geo: { "@type": "GeoShape", box: "18.9 -179.2 71.4 -66.9" } },
    variableMeasured: ["burn ban status", "NWS fire-weather alerts"],
    distribution: [
      { "@type": "DataDownload", name: "Active bans and restrictions (JSON API)", encodingFormat: "application/json", contentUrl: `${DOCS_ORIGIN}/api/v1/bans` },
      { "@type": "DataDownload", name: "Coverage and source health (JSON API)", encodingFormat: "application/json", contentUrl: `${DOCS_ORIGIN}/api/v1/coverage` },
      { "@type": "DataDownload", name: "API description (OpenAPI)", encodingFormat: "application/vnd.oai.openapi+json", contentUrl: `${DOCS_ORIGIN}/openapi.json` },
    ],
  },
];
---
<Base
  title="Burn ban dataset · Is There a Burn Ban?"
  description="Available US county burn-ban reports and restrictions, with a free read API, source links and check times."
  path="/data/"
  jsonLd={jsonLd}
>
  <main id="content" class="page dev">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Data</li>
      </ol>
    </nav>
    <h1>The burn ban dataset</h1>

    <h2 id="about">About this dataset</h2>
    <p>
      We publish county burn-ban reports and restrictions from the sources we check. A county answer can be
      <code>ban</code>, <code>restricted</code>, <code>none</code> or <code>unknown</code>.
      <code>None</code> means the feed reported no temporary county ban within its coverage. <code>Unknown</code> means the status is unconfirmed.
    </p>
    <p>
      {live.length} states have county-reporting feeds and {restrictions.length} areas have selected restriction sources.
      Iowa reports listed active proclamations only. We associate selected National Weather Service fire-weather alerts with counties.
      Check their coverage area, onset and source health. Some local rules apply during a Red Flag Warning.
    </p>
    <p>
      This service is informational. Confirm with the issuing authority before burning. We started collecting reports in November 2026.
    </p>

    <h2 id="get">Get the data</h2>
    <ul>
      <li><a href="/api/v1/bans"><code>/api/v1/bans</code></a> lists published active reports, including scoped restrictions. Pass <code>nextCursor</code> back as <code>cursor</code> to continue the national list. Add <code>?state=TX</code> for the full state list.</li>
      <li><a href="/api/v1/coverage"><code>/api/v1/coverage</code></a> lists configured sources, their checks and coverage.</li>
      <li><code>/api/v1/status</code> returns reports for exact county or place matches, or county candidates to confirm if the match is approximate.</li>
      <li><a href="/openapi.json"><code>/openapi.json</code></a> describes the read API. Find MCP setup on <a href="/developers/">Connect your agent</a>.</li>
    </ul>
    <p>No key or account required. Follow the response’s cache headers.</p>

    <h2 id="license">License and attribution</h2>
    <p>
      We classify publisher reports, issuing orders and standing rules. Keep the publisher and <code>officialUrl</code> when you share a report.
      For unconfirmed counties, that link may be a directory. See our <a href="/terms/">terms</a> for use of the site and API.
    </p>
    <p>
      Verify the original publisher's terms before republishing source records.
    </p>

    <h2 id="sources">Sources</h2>
    <h3>County-reporting feeds</h3>
    <ul>
      {live.map((s) => (
        <li><a href={statePath(s.abbr)}>{s.name}</a>: <a href={s.officialUrl} rel="noopener">{s.publisher}</a></li>
      ))}
    </ul>
    <h3>Restriction, permit and land-manager feeds</h3>
    <ul>
      {restrictions.map((s) => (
        <li><a href={statePath(s.abbr)}>{s.name}</a>: <a href={s.officialUrl} rel="noopener">{s.publisher}</a></li>
      ))}
    </ul>
    <h3>Fire weather</h3>
    <ul>
      <li><a href="https://www.weather.gov/" rel="noopener">National Weather Service</a> selected published alerts, including Red Flag Warnings and Fire Weather Watches.</li>
    </ul>
    {directory.length > 0 && <p>{directory.length} areas have official directory links. See <a href="/us/">all states</a>.</p>}

    <h2 id="updates">Update cadence</h2>
    <p>
      An hourly job schedules sources when they are due. A failed check can leave an earlier report visible through its freshness or validity window.
      <code>checked</code> is our last successful source check and is null for a directory-only result. <code>generated</code> is the publication time.
      <code>sourceUpdated</code> is a publisher timestamp when available. <code>since</code> is the effective date supplied by the publisher.
      <code>firstSeenAt</code> and <code>statusChangedAt</code> are dates recorded by this service.
    </p>
    <p>Send corrections or questions to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
  </main>
</Base>
