---
import Base from "../../layouts/Base.astro";
import Mark from "../../components/Mark.astro";
import { states } from "../../components/site-data";
import { STATE_BY_ABBR } from "../../shared/states-fips";

// stateFips -> {abbr, coverage}, embedded so the map needs no extra request to shade untracked states.
const coverage = Object.fromEntries(
  states.filter((s) => STATE_BY_ABBR[s.abbr]).map((s) => [STATE_BY_ABBR[s.abbr].fips, { abbr: s.abbr, coverage: s.coverage }]),
);
---
<Base title="Burn ban map · Is There a Burn Ban?" description="Map of current county burn bans and restrictions across the US, from official state sources." path="/map/" sheets footer={false}>
  <main id="content" class="map-page">
    <header class="map-bar">
      <h1><a href="/" aria-label="Is There a Burn Ban? Home"><Mark /><span class="map-site">Is There a Burn Ban?</span></a> <span class="map-label">Map</span></h1>
      <div class="map-actions">
        <button type="button" class="map-btn" data-pin-toggle aria-pressed="false">Drop a pin</button>
        <a class="map-btn" href="/us/"><span class="map-btn-long">Browse by state</span><span class="map-btn-short">States</span></a>
      </div>
    </header>
    <div class="map-wrap">
      <div id="map" data-coverage={JSON.stringify(coverage)} role="application" aria-label="County burn ban map. Use Browse by state for a list."></div>
      <p class="map-loading" data-map-loading>Loading map…</p>
      <details class="legend" data-legend>
        <summary>Legend</summary>
        <ul aria-label="Legend">
          <li><span style="background:#f34f49"></span>Burn ban</li>
          <li><span style="background:#f5a623"></span>Restrictions</li>
          <li><span style="background:#2a9d70"></span>No ban reported</li>
          <li><span style="background:#8fa3ad"></span>Can't confirm</li>
          <li><span style="background:#e4e4e4"></span>Not tracked</li>
        </ul>
      </details>
      <aside class="map-panel hero" data-map-panel hidden aria-live="polite">
        <button type="button" class="map-close" data-panel-close aria-label="Close">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" /></svg>
        </button>
        <div data-status-slot></div>
        <p class="hero-links">
          <button type="button" class="hero-link" data-sheet="alert">Alert me</button>
        </p>
      </aside>
    </div>
  </main>
</Base>

<style is:global>
  .map-page { display: flex; flex-direction: column; height: 100vh; height: 100dvh; }
  .map-bar { display: flex; flex-wrap: nowrap; gap: 0.75rem; align-items: center; justify-content: space-between; padding-block: max(0.5rem, env(safe-area-inset-top)) 0.5rem; padding-inline: max(1rem, env(safe-area-inset-left)) max(1rem, env(safe-area-inset-right)); border-bottom: 1px solid var(--line); }
  .map-bar h1 { font-size: 1.05rem; font-weight: 800; margin: 0; white-space: nowrap; overflow: clip; text-overflow: ellipsis; min-width: 0; }
  .map-bar h1 { display: flex; align-items: center; gap: 0.4rem; }
  .map-bar h1 a { color: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; }
  .map-bar h1 .mark-svg { color: #f34f49; width: 1.4rem; height: 1.4rem; flex: none; }
  .map-label { color: var(--muted); font-weight: 600; }
  .map-btn-short { display: none; }
  .map-actions { display: flex; gap: 0.4rem; flex: none; }
  .map-btn { font: inherit; font-weight: 700; font-size: 0.85rem; min-height: 2.25rem; padding: 0.3rem 0.8rem; border-radius: 999px; border: 2px solid #1a1a1a; background: #fff; color: #1a1a1a; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; white-space: nowrap; }
  .map-btn[aria-pressed="true"] { background: #1a1a1a; color: #fff; }
  .map-wrap { position: relative; flex: 1; min-height: 20rem; }
  #map { position: absolute; inset: 0; background: #f7f7f5; }
  #map.pin-mode { cursor: crosshair; }
  .map-loading { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; font-weight: 700; pointer-events: none; }
  /* Bottom-left: zoom is top-left, attribution bottom-right. Lifted above the attribution row. */
  .legend { position: absolute; left: max(0.75rem, env(safe-area-inset-left)); bottom: max(1.75rem, env(safe-area-inset-bottom)); z-index: 500; margin: 0; padding: 0.4rem 0.75rem; background: rgb(255 255 255 / 0.95); border-radius: 10px; font-size: 0.8rem; font-weight: 600; box-shadow: 0 2px 10px rgb(0 0 0 / 0.15); max-width: calc(100% - 1.5rem); }
  .legend summary { cursor: pointer; font-weight: 700; min-height: 1.75rem; display: flex; align-items: center; gap: 0.35rem; }
  .legend ul { list-style: none; margin: 0.25rem 0 0.15rem; padding: 0; }
  .legend li { display: flex; align-items: center; gap: 0.4rem; }
  .legend li span { width: 0.9rem; height: 0.9rem; border-radius: 3px; border: 1px solid rgb(0 0 0 / 0.25); flex: none; }
  .map-panel { position: absolute; z-index: 600; right: 0.75rem; top: 0.75rem; width: min(22rem, calc(100% - 1.5rem)); min-height: 0; padding: 1.25rem 1rem 0.5rem; border-radius: 14px; box-shadow: 0 8px 30px rgb(0 0 0 / 0.3); }
  .map-panel[hidden] { display: none; }
  .map-panel .status-word { font-size: 3.5rem; }
  .map-panel .status-sentence { font-size: 1.05rem; margin-top: 0.5rem; }
  .map-panel .hero-links { margin-top: 0.25rem; }
  .map-close { position: absolute; top: 0.5rem; right: 0.5rem; display: grid; place-items: center; background: rgb(0 0 0 / 0.2); color: inherit; border: 0; border-radius: 999px; width: 2.25rem; height: 2.25rem; cursor: pointer; }
  @media (max-width: 640px) {
    .map-btn-long, .map-site { display: none; }
    .map-btn-short { display: inline; }
    .map-label { color: var(--ink); font-weight: 800; }
    .map-panel { top: auto; left: 0.75rem; right: 0.75rem; width: auto; bottom: max(1.75rem, env(safe-area-inset-bottom)); }
    /* The panel takes the bottom of the map; the legend steps aside while it is open. */
    .map-wrap:has(.map-panel:not([hidden])) .legend { display: none; }
  }
</style>

<script>
  // Legend starts open where there's room for it, collapsed on phones.
  const legend = document.querySelector<HTMLDetailsElement>("[data-legend]");
  if (legend && matchMedia("(min-width: 641px)").matches) legend.open = true;
  // Leaflet + TopoJSON load only on this page, after first paint.
  const start = () => import("../../client/map").then((m) => m.initMap());
  if ("requestIdleCallback" in window) requestIdleCallback(start, { timeout: 1500 });
  else setTimeout(start, 50);
</script>
