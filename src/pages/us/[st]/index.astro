---
import Base from "../../../layouts/Base.astro";
import StateIcon from "../../../components/StateIcon.astro";
import { SITE, COVERAGE_LABEL, countiesIn, countyPath, placesInState, states, stateCitiesPath, statePath } from "../../../components/site-data";
import type { StateDirectoryEntry } from "../../../shared/types";

export function getStaticPaths() {
  return states.map((s) => ({ params: { st: s.abbr.toLowerCase() }, props: { s } }));
}

const { s } = Astro.props as { s: StateDirectoryEntry };
const list = countiesIn(s.abbr);
const cityCount = placesInState(s.abbr).length;
const unit = s.abbr === "LA" ? "parishes" : s.abbr === "AK" ? "boroughs and census areas" : "counties";
const unitOne = s.abbr === "LA" ? "parish" : s.abbr === "AK" ? "borough or census area" : "county";
const findLabel = s.abbr === "LA" ? "Find your parish" : s.abbr === "AK" ? "Find your borough" : "Find your county";
// Long lists get a letter index and a filter; Delaware's three counties need neither.
const useIndex = list.length > 30;
const useFilter = list.length > 12;
const groups = useIndex
  ? [...new Set(list.map((c) => c.name[0].toUpperCase()))].map((letter) => ({ letter, list: list.filter((c) => c.name[0].toUpperCase() === letter) }))
  : [{ letter: "", list }];
const title = `Burn bans in ${s.name}`;
const description = `Available burn-ban reports, county pages and reporting agencies for ${s.name}.`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "States", item: `${SITE}/us/` },
      { "@type": "ListItem", position: 3, name: s.name, item: `${SITE}${statePath(s.abbr)}` },
    ],
  },
];
---
<Base title={title} description={description} path={statePath(s.abbr)} jsonLd={jsonLd}>
  <main id="content" class="page browse">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/us/">States</a></li>
        <li aria-current="page">{s.name}</li>
      </ol>
    </nav>
    <div class={`state-head row--${s.coverage}`}>
      <StateIcon abbr={s.abbr} class="st-icon st-icon--lg" />
      <div>
        <h1>{title}</h1>
        <p class="state-badge"><span class={`badge badge--${s.coverage}`}>{COVERAGE_LABEL[s.coverage]}</span></p>
      </div>
    </div>

    {s.coverage !== "directory" && (
      <details class="banned" data-banned>
        <summary><span data-ban-count data-state={s.abbr} aria-live="polite"><strong>Checking published reports…</strong></span></summary>
        <ul class="rows rows--places rows--cols" role="list"></ul>
      </details>
    )}
    {s.coverage === "restrictions" && (
      <p class="callout">Sources cover selected areas and activities. Check the county report and the authority for your burn site.</p>
    )}
    {s.abbr === "IA" && <p class="callout">Iowa's feed lists active proclamations. Other county statuses stay unconfirmed.</p>}

    <h2 id="places">All {list.length} {unit}</h2>
    {useFilter && (
      <form class="finder" data-finder role="search" action={statePath(s.abbr)}>
        <label class="finder-label" for="q">{findLabel}</label>
        <input id="q" name="q" type="search" autocomplete="off" autocapitalize="words" spellcheck="false" enterkeyhint="go" placeholder={`Start typing a ${unitOne.split(" ")[0]} name`} />
        <p class="finder-status" data-finder-status role="status"></p>
      </form>
    )}
    {useIndex && (
      <nav class="az" aria-label="Jump to a letter" data-unfiltered>
        <ul role="list">
          {groups.map((g) => <li><a href={`#letter-${g.letter.toLowerCase()}`}>{g.letter}</a></li>)}
        </ul>
      </nav>
    )}
    <div class="az-list az-list--places" data-county-list data-unit={unit} data-unit-one={unitOne}>
      {groups.map((g) => (
        <section class="az-group" data-group aria-labelledby={g.letter ? `letter-${g.letter.toLowerCase()}` : undefined}>
          {g.letter && <h3 class="az-head" id={`letter-${g.letter.toLowerCase()}`}>{g.letter}</h3>}
          <ul class="rows rows--places" role="list">
            {g.list.map((c) => (
              <li data-row={c.name} data-fips={c.fips}>
                <a class="row" href={countyPath(c)}><span class="row-name">{c.name}</span></a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    {cityCount > 0 && <p><a href={stateCitiesPath(s.abbr)}>Look up by city ({cityCount} cities and towns) →</a></p>}

    <h2>Who issues bans</h2>
    <p>{s.notes}</p>

    <h2>Official source</h2>
    <ul>
      <li><a href={s.officialUrl} target="_blank" rel="noopener">{s.publisher} ↗︎</a></li>
      {s.extraUrls?.map((x) => <li><a href={x.url} target="_blank" rel="noopener">{x.label} ↗︎</a></li>)}
    </ul>

    <p class="back"><a href="/us/">All states</a></p>
  </main>
</Base>

<script>
  import { initCountyFinder } from "../../../client/browse";
  initCountyFinder();
</script>
