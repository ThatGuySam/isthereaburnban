---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { SITE } from "../components/site-data";

const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: "Is There a Burn Ban?", url: `${SITE}/` },
];
---
<Base
  title="Is There a Burn Ban?"
  description="Look up available burn-ban reports and restrictions for your area. See which places and activities they cover."
  path="/"
  jsonLd={jsonLd}
  themeColor="#767676"
  sheets
  footer={false}
>
  <Hero mode="home" />
</Base>
