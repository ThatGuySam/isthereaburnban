    <Folder>
      <name>Unincorporated Eagle County (non-Federal/State lands)</name>
      <Placemark>
        <name>Unincorporated Eagle County</name>
        <description><![CDATA[Green = No Restrictions<br>Yellow = Stage 1<br>Red = Stage 2<br>Black = Stage 3<br><br>When fire restrictions are in place, information on activities that are prohibited on Unincorporated County, Municipal, or State land in Eagle County can be found at:<br>https://sites.google.com/eaglecounty.us/ecemergency/fire-restrictions]]></description>
        <styleUrl>#line-0F9D58-1770</styleUrl>
        <MultiGeometry></MultiGeometry>
      </Placemark>
    </Folder>
