---
import { heroStyle, renderAskHtml, renderCheckingHtml } from "../shared/render";
import { PLACE_KEY } from "../client/place";
import Mark from "./Mark.astro";

interface Props {
  /** "home" asks for a location first and remembers it; "county" shows one county (Worker-injected) */
  mode: "home" | "county";
  fips?: string;
  place?: string;
  /** county page path, for the menu's links */
  url?: string;
  /** quiet line under the answer, e.g. "Tulsa is in Tulsa County." (the Worker keeps it when it injects status) */
  note?: string;
}
const { mode, fips, place, url, note } = Astro.props;
const home = mode === "home";
// Keep this markup in sync with src/worker/pages.ts, which rewrites [data-hero] and [data-status-slot].
const ask = renderAskHtml();
---
<main
  id="content"
  class="hero"
  data-hero
  data-mode={mode}
  data-state={home ? "ask" : "answer"}
  data-status="checking"
  style={heroStyle("checking")}
>
  <div class="hero-inner">
    {home && <h1 class="sr-only">Is there a burn ban near you?</h1>}
    <div data-status-slot data-fips={fips} data-note={note} aria-live="polite" set:html={home ? ask : renderCheckingHtml(place)} />
    {home && (
      <div class="hero-ask">
        <button type="button" class="hero-cta" data-locate>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M21 3 3 10.5l7.5 3 3 7.5L21 3Z" fill="currentColor" /></svg>
          Use my location
        </button>
        <button type="button" class="hero-link" data-sheet="location">or enter a ZIP</button>
      </div>
    )}
    <p class="hero-links">
      <button type="button" class="hero-link" data-sheet="location">Change location</button>
      <button type="button" class="hero-link" data-sheet="alert" data-fips={fips} data-place={place}>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 3a6 6 0 0 0-6 6v3.5L4.5 16h15L18 12.5V9a6 6 0 0 0-6-6Zm-2 15a2 2 0 0 0 4 0h-4Z" fill="currentColor" /></svg>
        Alert me
      </button>
    </p>
  </div>
  <button type="button" class="hero-mark" data-sheet="menu" data-fips={fips} data-place={place} data-url={url} aria-label="Menu">
    <Mark />
  </button>
</main>

{home && (
  <script is:inline define:vars={{ placeKey: PLACE_KEY, checking: renderCheckingHtml(), checkingStyle: heroStyle("checking") }}>
    try {
      var stored = JSON.parse(localStorage.getItem(placeKey) || localStorage.getItem("itabb:last") || "null");
      var query = new URLSearchParams(location.search);
      if (/^\d{5}$/.test(stored?.fips || "") || query.has("zip") || query.has("fips") || (query.has("lat") && query.has("lon"))) {
        var h = document.querySelector("[data-hero]");
        h.dataset.state = "checking";
        h.dataset.status = "checking";
        h.style.cssText = checkingStyle;
        h.querySelector("[data-status-slot]").innerHTML = checking;
      }
    } catch (e) {}
  </script>
)}

<script>
  import { initHero } from "../client/hero";
  initHero();
</script>
